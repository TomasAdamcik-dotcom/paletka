#: extension/extension.js:305 extension/extension.js:548
msgid "Paletka"
msgstr "Paletka"

#: extension/extension.js:366
msgid "Theme changed"
msgstr "Téma zmenená"

#: extension/extension.js:366
msgid "Open apps will use the new colors after they are reopened."
msgstr "Otvorené aplikácie použijú nové farby po opätovnom spustení."

#: extension/extension.js:517
msgid "Old color settings found"
msgstr "Nájdené staré nastavenia farieb"

#: extension/extension.js:518
#, javascript-format
msgid ""
"%s pins light colors with the old @define-color syntax. Apps may be "
"unreadable in dark mode when you switch back to Ubuntu. Move or delete that "
"file if you see this."
msgstr ""
"%s pevne nastavuje svetlé farby starým zápisom @define-color. Po návrate na "
"Ubuntu môžu byť aplikácie v tmavom režime nečitateľné. Ak to uvidíte, súbor "
"presuňte alebo odstráňte."

#: extension/extension.js:533
#, javascript-format
msgid "VS Code theme for %s is not installed"
msgstr "Téma VS Code pre %s nie je nainštalovaná"

#: extension/extension.js:534
msgid "Install it so VS Code switches together with the desktop theme."
msgstr ""
"Nainštalujte ju, aby sa VS Code prepínal spolu s témou pracovnej plochy."

#: extension/extension.js:537
msgid "Install theme"
msgstr "Nainštalovať tému"

#: extension/extension.js:563
msgid "VS Code theme was not installed"
msgstr "Téma VS Code sa nenainštalovala"

#: extension/extension.js:564
msgid "The VS Code command line (code) was not found."
msgstr "Príkaz VS Code (code) sa nenašiel."

#: extension/extension.js:567
msgid "VS Code theme installed"
msgstr "Téma VS Code je nainštalovaná"

#: extension/extension.js:567
msgid "VS Code now follows the desktop theme."
msgstr "VS Code sa teraz prepína spolu s témou pracovnej plochy."

#: extension/lib/prefs/browsersPage.js:18
msgid "Off"
msgstr "Vypnuté"

#: extension/lib/prefs/browsersPage.js:19
msgid "Install the Paletka extension in this browser"
msgstr "Nainštalujte rozšírenie Paletka v tomto prehliadači"

#: extension/lib/prefs/browsersPage.js:20
msgid "Focus Firefox and allow Paletka in the system dialog"
msgstr "Prepnite sa do Firefoxu a povoľte Paletku v systémovom dialógu"

#: extension/lib/prefs/browsersPage.js:21
msgid "Active"
msgstr "Aktívne"

#: extension/lib/prefs/browsersPage.js:42
msgid "Browsers"
msgstr "Prehliadače"

#: extension/lib/prefs/browsersPage.js:49
msgid "Web pages"
msgstr "Webové stránky"

#: extension/lib/prefs/browsersPage.js:50
msgid ""
"Recolor web pages with the active theme. Each browser needs the Paletka "
"browser extension."
msgstr ""
"Prefarbí webové stránky aktívnou témou. Každý prehliadač potrebuje "
"rozšírenie Paletka."

#: extension/lib/prefs/browsersPage.js:55
msgid "No supported browser found"
msgstr "Nenašiel sa žiadny podporovaný prehliadač"

#: extension/lib/prefs/browsersPage.js:60
msgid "Get Extension"
msgstr "Získať rozšírenie"

#: extension/lib/prefs/browsersPage.js:68
msgid "Theme Chrome’s window"
msgstr "Farbiť aj okno Chromu"

#: extension/lib/prefs/browsersPage.js:69
msgid ""
"Restarts Chrome with GTK 3 from now on. Also choose Appearance → Mode → GTK "
"in Chrome’s settings."
msgstr ""
"Odteraz spúšťa Chrome s GTK 3. V nastaveniach Chromu zvoľte aj Vzhľad → "
"Režim → GTK."

